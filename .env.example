# Application
APP_ENV=development
APP_VERSION=0.0.0
LOG_LEVEL=info
HEALTHCHECK_TOKEN=replace-with-token
APP_ENCRYPTION_KEY=
MFA_ISSUER=Saudi Waqef
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
CACHE_TTL_MS=60000

# NextAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ops
FIRESTORE_BACKUP_BUCKET=

# Cron (Vercel Cron auto-injects Authorization: Bearer $CRON_SECRET; also
# accepts x-cron-token header / ?token= query param for manual testing)
CRON_SECRET=

# Email (SMTP)
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_DISPATCH_TOKEN=
EMAIL_SEND_MODE=queue
# Gmail preset (use App Passwords)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
